#!/bin/bash
# Généré par Ansible - ne pas éditer à la main.
# Seul point d'entrée root du panneau Minecraft. Appelé via sudo avec des
# sous-commandes FIXES (aucun argument libre) : voir minecraft-sudoers.j2.
# Les messages d'erreur (stderr) sont affichés tels quels dans le panneau,
# d'où l'anglais.
set -euo pipefail

NAME=homestead
DATA=/var/minecraft-homestead-data
STATE=/var/lib/minecraft-panel
CONFIG=$STATE/config.json       # écrit par l'appli (non fiable) -> validé ici
REQUEST=$STATE/request.json     # sauvegarde visée par restore/delete (non fiable)
MODS_LIST=$STATE/mods.json      # mods Modrinth en plus du modpack, par slug (non fiable)
MODS_TRACK=$DATA/.panel-mods.json  # jars posés par sync_mods (pour pouvoir les retirer)
UPLOAD=/var/minecraft-uploads/incoming.zip
BACKUPS=/var/minecraft-backups  # <slug>/<AAAAMMJJ-HHMMSS>.tar.gz + .json
CF_KEY_FILE=/etc/minecraft/cf_api_key
HEAP="{{ minecraft_heap }}"
VIEW_DISTANCE="{{ minecraft_view_distance }}"
SIMULATION_DISTANCE="{{ minecraft_simulation_distance }}"
IMAGE="itzg/minecraft-server:java17"
MAX_UNZIPPED_MB=8192
KEEP_AUTO=5                     # sauvegardes automatiques gardées par modpack
MODRINTH_API=https://api.modrinth.com/v2
USER_AGENT="bylucas/minecraft-ctl (monitor.bylucas.eu)"

SLUG_RE='^[a-z0-9][a-z0-9-]{0,79}$'
FILE_ID_RE='^[0-9]{1,10}$'
STAMP_RE='^[0-9]{8}-[0-9]{6}$'
VERSION_ID_RE='^[A-Za-z0-9]{8}$'
JAR_RE='^[A-Za-z0-9][A-Za-z0-9._+-]{0,150}\.jar$'
SHA512_RE='^[0-9a-f]{128}$'

die() { echo "$*" >&2; exit 1; }

level_name() {
  local l
  l=$(grep -E '^level-name=' "$DATA/server.properties" 2>/dev/null | head -1 | cut -d= -f2- || true)
  l=${l:-world}
  # nom de dossier sûr uniquement
  [[ "$l" =~ ^[A-Za-z0-9._\ ()-]+$ && "$l" != *..* ]] || die "invalid level-name in server.properties"
  echo "$l"
}

container_env() {
  docker inspect -f '{{ '{{range .Config.Env}}{{println .}}{{end}}' }}' "$NAME" 2>/dev/null \
    | sed -n "s/^$1=//p" | head -1 || true
}

# Modpack avec lequel le monde actuel a été joué : celui du conteneur (même
# arrêté), sinon celui de la config.
current_slug() {
  local s; s=$(container_env CF_SLUG)
  [ -n "$s" ] || s=$(jq -r '.slug // empty' "$CONFIG" 2>/dev/null || true)
  [[ "$s" =~ $SLUG_RE ]] && echo "$s" || echo unknown
}

current_file_id() {
  local f; f=$(container_env CF_FILE_ID)
  [[ "$f" =~ $FILE_ID_RE ]] && echo "$f" || echo ""
}

# backup_world <reason> : archive le monde dans $BACKUPS/<slug>/.
# Le serveur doit être arrêté, ou les sauvegardes auto suspendues (save-off).
backup_world() {
  local reason=$1 lvl slug stamp dir
  lvl=$(level_name)
  [ -d "$DATA/$lvl" ] || return 0
  slug=$(current_slug)
  stamp=$(date +%Y%m%d-%H%M%S)
  dir=$BACKUPS/$slug
  mkdir -p "$dir"; chmod 700 "$BACKUPS" "$dir"
  tar -czf "$dir/$stamp.tar.gz" -C "$DATA" "$lvl"
  jq -n --arg slug "$slug" --arg fileId "$(current_file_id)" --arg reason "$reason" \
        --arg createdAt "$(date -Iseconds)" \
        '{slug: $slug, fileId: $fileId, reason: $reason, createdAt: $createdAt}' > "$dir/$stamp.json"
  prune_auto "$dir"
}

# Garde les $KEEP_AUTO sauvegardes automatiques les plus récentes du dossier ;
# les sauvegardes manuelles ne sont jamais supprimées automatiquement.
prune_auto() {
  local dir=$1 m n=0
  for m in $(ls -1r "$dir"/*.json 2>/dev/null); do
    [ "$(jq -r .reason "$m")" = manual ] && continue
    n=$((n + 1))
    [ "$n" -gt "$KEEP_AUTO" ] && rm -f -- "$m" "${m%.json}.tar.gz"
  done
  return 0
}

# Lit et valide $REQUEST ({"id": "<slug>/<stamp>"}) ; renseigne REQ_DIR et REQ_STAMP.
read_request() {
  local id slug stamp
  id=$(jq -r '.id // empty' "$REQUEST" 2>/dev/null || true)
  slug=${id%%/*}; stamp=${id#*/}
  [[ "$id" == */* && ( "$slug" =~ $SLUG_RE || "$slug" == unknown ) && "$stamp" =~ $STAMP_RE ]] \
    || die "invalid backup id"
  REQ_DIR=$BACKUPS/$slug; REQ_STAMP=$stamp
  [ -f "$REQ_DIR/$REQ_STAMP.tar.gz" ] || die "backup not found"
}

# Pendant une copie à chaud : suspend les sauvegardes auto du serveur et force
# l'écriture du monde ; save-on est rétabli à la sortie du script.
pause_saving() {
  if docker exec "$NAME" rcon-cli save-off >/dev/null 2>&1; then
    trap 'docker exec "$NAME" rcon-cli save-on >/dev/null 2>&1 || true' EXIT
    docker exec "$NAME" rcon-cli save-all flush >/dev/null 2>&1 || true
  fi
}

clean_mods() {
  rm -rf -- "$DATA/mods" "$DATA/config" "$DATA/.curseforge" "$DATA"/.curseforge-* "$MODS_TRACK" 2>/dev/null || true
}

config_slug() {
  local s; s=$(jq -r '.slug // empty' "$CONFIG" 2>/dev/null || true)
  [[ "$s" =~ $SLUG_RE ]] || die "invalid modpack slug"
  echo "$s"
}

# sync_mods <slug> : aligne mods/ sur la liste $MODS_LIST[<slug>] (versions
# Modrinth). Chaque jar vient de cdn.modrinth.com et est vérifié en SHA-512 ;
# ceux posés par une synchro précédente et absents de la liste sont retirés.
# Les jars du modpack ne sont jamais touchés. SYNC_CHANGED=1 si mods/ a changé.
sync_mods() {
  local slug=$1 id v url name sha tmp want=() old
  SYNC_CHANGED=0
  mkdir -p "$DATA/mods"
  for id in $(jq -r --arg s "$slug" '.[$s] // [] | .[].versionId' "$MODS_LIST" 2>/dev/null || true); do
    [[ "$id" =~ $VERSION_ID_RE ]] || die "invalid mod version id"
    v=$(curl -fsS --max-time 30 -A "$USER_AGENT" "$MODRINTH_API/version/$id") || die "Modrinth unreachable (version $id)"
    v=$(jq -c '(.files | map(select(.primary)) | .[0]) // .files[0]' <<<"$v")
    url=$(jq -r .url <<<"$v"); name=$(jq -r .filename <<<"$v"); sha=$(jq -r .hashes.sha512 <<<"$v")
    [[ "$url" == https://cdn.modrinth.com/* ]] || die "unexpected download host for $id"
    [[ "$name" =~ $JAR_RE && "$sha" =~ $SHA512_RE ]] || die "unexpected mod file for $id"
    want+=("$name")
    echo "$sha  $DATA/mods/$name" | sha512sum -c --status 2>/dev/null && continue
    tmp=$(mktemp "$DATA/mods/.download.XXXXXX")
    curl -fsSL --max-time 300 -A "$USER_AGENT" -o "$tmp" "$url" || { rm -f -- "$tmp"; die "download failed: $name"; }
    echo "$sha  $tmp" | sha512sum -c --status || { rm -f -- "$tmp"; die "checksum mismatch: $name"; }
    chown 1000:1000 "$tmp"; chmod 644 "$tmp"
    mv -f -- "$tmp" "$DATA/mods/$name"
    SYNC_CHANGED=1
  done
  for old in $(jq -r '.[]?' "$MODS_TRACK" 2>/dev/null || true); do
    [[ "$old" =~ $JAR_RE ]] || continue
    [[ " ${want[*]} " == *" $old "* ]] && continue
    rm -f -- "$DATA/mods/$old"
    SYNC_CHANGED=1
  done
  jq -n '$ARGS.positional' --args "${want[@]}" > "$MODS_TRACK"
}

is_running() {
  [ "$(docker inspect -f '{{ '{{.State.Running}}' }}' "$NAME" 2>/dev/null)" = true ]
}

run_container() {
  local slug file_id
  slug=$(jq -r '.slug // empty' "$CONFIG"); file_id=$(jq -r '.fileId // empty' "$CONFIG")
  [[ "$slug" =~ $SLUG_RE ]] || die "invalid modpack slug"
  [[ -z "$file_id" || "$file_id" =~ $FILE_ID_RE ]] || die "invalid file ID"
  local args=(run -d --name "$NAME" --restart unless-stopped -p 25565:25565
    -e EULA=TRUE -e TYPE=AUTO_CURSEFORGE -e "CF_API_KEY=$(cat "$CF_KEY_FILE")"
    -e "CF_SLUG=$slug" -e "MEMORY=$HEAP" -v "$DATA:/data"
    # Chunks : flags GC d'Aikar (moins de pauses), écritures de chunks non
    # bloquantes, distances réduites (voir defaults/main.yml).
    -e USE_AIKAR_FLAGS=true -e SYNC_CHUNK_WRITES=false
    -e "VIEW_DISTANCE=$VIEW_DISTANCE" -e "SIMULATION_DISTANCE=$SIMULATION_DISTANCE")
  [ -n "$file_id" ] && args+=(-e "CF_FILE_ID=$file_id")
  docker "${args[@]}" "$IMAGE" >/dev/null
}

recreate_container() {
  docker rm "$NAME" 2>/dev/null || true
  run_container
}

# Une seule opération à la fois (double clic, deux onglets...).
if [ "${1:-}" != list-backups ]; then
  exec 9>/run/minecraft-ctl.lock
  flock -n 9 || die "another Minecraft operation is already running"
fi

case "${1:-}" in
  start)   docker start "$NAME" ;;
  stop)    docker stop -t 60 "$NAME" ;;     # laisse le temps de sauvegarder le monde
  restart) docker restart -t 60 "$NAME" ;;

  apply|apply-clean)
    # Recrée le conteneur avec le modpack de $CONFIG. Le volume (monde) est conservé.
    docker stop -t 60 "$NAME" 2>/dev/null || true
    if [ "$1" = apply-clean ]; then
      backup_world before-modpack-change
      clean_mods
    fi
    sync_mods "$(config_slug)"
    recreate_container ;;

  create)  # utilisé par Ansible au premier déploiement
    if ! docker inspect "$NAME" >/dev/null 2>&1; then
      sync_mods "$(config_slug)"
      run_container
    fi ;;

  sync-mods)
    # Après un changement de la liste dans le panneau (ou par Ansible).
    # Redémarre le serveur seulement si mods/ a changé et qu'il tourne.
    sync_mods "$(current_slug)"
    if [ "$SYNC_CHANGED" = 1 ]; then
      is_running && docker restart -t 60 "$NAME" >/dev/null
      echo changed
    else
      echo unchanged
    fi ;;

  export-world)
    # Zip en flux sur stdout (jamais de fichier temporaire de la taille du monde).
    lvl=$(level_name)
    cd "$DATA"
    pause_saving
    zip -q -r - "$lvl" ;;

  import-world)
    [ -f "$UPLOAD" ] || die "no uploaded file"
    lvl=$(level_name)
    # Validation : zip valide, pas de chemin dangereux, level.dat présent, taille raisonnable
    unzip -tqq "$UPLOAD" >/dev/null || die "invalid zip file"
    if unzip -Z1 "$UPLOAD" | grep -Eq '(^/|(^|/)\.\.(/|$))'; then die "zip contains unsafe paths"; fi
    ldat=$(unzip -Z1 "$UPLOAD" | grep -E '(^|/)level\.dat$' | awk -F/ '{print NF-1" "$0}' | sort -n | head -1 | cut -d' ' -f2-)
    [ -n "$ldat" ] || die "level.dat not found: this is not a Minecraft world"
    total=$(unzip -Zt "$UPLOAD" | awk '{print int($3/1048576)}')
    [ "${total:-0}" -le "$MAX_UNZIPPED_MB" ] || die "world is too big (max ${MAX_UNZIPPED_MB} MB unzipped)"
    prefix=${ldat%level.dat}           # "" ou "Mon Monde/"
    tmp=$(mktemp -d "$DATA/.import.XXXXXX")
    unzip -q "$UPLOAD" -d "$tmp"
    docker stop -t 60 "$NAME" 2>/dev/null || true
    backup_world before-import
    rm -rf -- "${DATA:?}/$lvl"
    mv -- "$tmp/${prefix%/}" "$DATA/$lvl" 2>/dev/null || { mkdir -p "$DATA/$lvl"; cp -a "$tmp/." "$DATA/$lvl/"; }
    rm -rf -- "$tmp" "$UPLOAD"
    chown -R 1000:1000 "$DATA/$lvl"
    docker start "$NAME" >/dev/null ;;

  new-world)
    # Le serveur régénère un monde au démarrage si le dossier n'existe plus ;
    # level-seed vidé = graine aléatoire.
    lvl=$(level_name)
    docker stop -t 60 "$NAME" 2>/dev/null || true
    backup_world before-new-world
    rm -rf -- "${DATA:?}/$lvl"
    sed -i 's/^level-seed=.*/level-seed=/' "$DATA/server.properties"
    docker start "$NAME" >/dev/null ;;

  save-world)
    pause_saving
    backup_world manual ;;

  list-backups)
    # JSON sur stdout, du plus récent au plus ancien.
    for m in "$BACKUPS"/*/*.json; do
      [ -f "$m" ] || continue
      t=${m%.json}.tar.gz; [ -f "$t" ] || continue
      d=${m%/*}
      jq -c --arg id "${d##*/}/$(basename "$m" .json)" --argjson size "$(stat -c %s "$t")" \
        '. + {id: $id, size: $size}' "$m"
    done | jq -s 'sort_by(.createdAt) | reverse' ;;

  restore-world)
    read_request
    meta=$REQ_DIR/$REQ_STAMP.json
    target_slug=$(jq -r '.slug // empty' "$meta"); target_file_id=$(jq -r '.fileId // empty' "$meta")
    lvl=$(level_name)
    tmp=$(mktemp -d "$DATA/.restore.XXXXXX")
    tar -xzf "$REQ_DIR/$REQ_STAMP.tar.gz" -C "$tmp"
    src=$(find "$tmp" -mindepth 1 -maxdepth 1 -type d | head -1)
    [ -n "$src" ] && [ -f "$src/level.dat" ] || { rm -rf -- "$tmp"; die "backup does not contain a world"; }
    docker stop -t 60 "$NAME" 2>/dev/null || true
    backup_world before-restore
    rm -rf -- "${DATA:?}/$lvl"
    mv -- "$src" "$DATA/$lvl"
    rm -rf -- "$tmp" "$REQUEST"
    chown -R 1000:1000 "$DATA/$lvl"
    # Monde d'un autre modpack : on bascule aussi le serveur sur ce modpack,
    # sinon les blocs/objets des mods manquants seraient perdus.
    if [[ "$target_slug" =~ $SLUG_RE && "$target_slug" != "$(current_slug)" ]]; then
      jq -n --arg slug "$target_slug" --arg fileId "$target_file_id" '{slug: $slug, fileId: $fileId}' > "$CONFIG.tmp"
      cat "$CONFIG.tmp" > "$CONFIG"; rm -f -- "$CONFIG.tmp"   # garde propriétaire et droits
      clean_mods
      sync_mods "$target_slug"
      recreate_container
    else
      docker start "$NAME" >/dev/null
    fi ;;

  delete-backup)
    read_request
    rm -f -- "$REQ_DIR/$REQ_STAMP.tar.gz" "$REQ_DIR/$REQ_STAMP.json" "$REQUEST"
    rmdir "$REQ_DIR" 2>/dev/null || true ;;

  *) die "usage: minecraft-ctl start|stop|restart|apply|apply-clean|create|sync-mods|export-world|import-world|new-world|save-world|list-backups|restore-world|delete-backup" ;;
esac
