#!/usr/bin/env bash
# Sauvegarde quotidienne de toutes les bases PostgreSQL applicatives.
# Conserve {{ postgresql_backup_retention_days }} jours d'historique.

set -euo pipefail

BACKUP_DIR="{{ postgresql_backup_dir }}"
RETENTION_DAYS="{{ postgresql_backup_retention_days }}"
DATE=$(date +%Y-%m-%d)

mkdir -p "$BACKUP_DIR"

sudo -u postgres pg_dumpall | gzip > "$BACKUP_DIR/all-databases-$DATE.sql.gz"

find "$BACKUP_DIR" -name "*.sql.gz" -mtime +"$RETENTION_DAYS" -delete
